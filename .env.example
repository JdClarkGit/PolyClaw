# PolyClaw Configuration
# Copy this file to .env and fill in your values
# NEVER commit your .env file to git!

# =============================================================================
# SERVER SETTINGS
# =============================================================================

# Port to run PolyClaw on (default: 8080)
PORT=8080

# Enable debug mode (set to false in production)
DEBUG=false

# Secret key for session security (generate a random string)
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# =============================================================================
# AI PROVIDERS (OPTIONAL)
# =============================================================================
# Basic features work without any API keys!
# Add these for AI-powered analysis and chat features.

# OpenAI API Key (for GPT-4 analysis)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API Key (for Claude analysis - recommended)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# =============================================================================
# TELEGRAM BOT (OPTIONAL)
# =============================================================================
# For interactive Telegram bot (2-way chat, not just alerts)
# Create a bot: Message @BotFather → /newbot → Get token

# Your Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of allowed Telegram user IDs (leave empty for no restrictions)
# Get your ID: Message @userinfobot
TELEGRAM_ALLOWED_USERS=

# =============================================================================
# DISCORD BOT (OPTIONAL)
# =============================================================================
# For interactive Discord bot (2-way chat, not just webhooks)
# Create a bot: discord.com/developers/applications → New Application → Bot

# Your Discord bot token
DISCORD_BOT_TOKEN=

# Comma-separated list of guild IDs to sync commands to (leave empty for global)
DISCORD_GUILD_IDS=

# =============================================================================
# NOTIFICATION WEBHOOKS (CONFIGURED VIA UI)
# =============================================================================
# Discord webhooks (one-way alerts) are configured through the Settings UI
# These are separate from the interactive Discord bot above

# =============================================================================
# ADVANCED SETTINGS (OPTIONAL)
# =============================================================================

# Maximum number of trades to fetch in full history mode
# MAX_TRADES=10000

# Rate limiting (requests per minute)
# RATE_LIMIT=60

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
