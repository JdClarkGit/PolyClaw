# PolyEdge.io Environment Variables
# Copy this file to .env and fill in your values

# Flask
SECRET_KEY=your-secret-key-change-in-production
FLASK_ENV=development

# Database (for production, use a cloud database URL)
DATABASE_URL=sqlite:///polyedge.db
# For Vercel/Production, use Supabase, Neon, or PlanetScale:
# DATABASE_URL=postgresql://user:password@host:5432/database

# Stripe (get these from https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create these in Stripe Dashboard > Products)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_SCALE=price_...

# Frontend URL (for Stripe redirects)
FRONTEND_URL=http://localhost:8080
# For production:
# FRONTEND_URL=https://polyedge.io
